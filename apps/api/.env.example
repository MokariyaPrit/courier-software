NODE_ENV=development
PORT=3001
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=courier
DATABASE_PASSWORD=courier
DATABASE_NAME=courier_erp
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
SMTP_CRYPTO_SECRET=change-me-smtp-crypto-secret-min-32!!
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
COOKIE_SECURE=false
CORS_ORIGIN=http://localhost:3000
SEED_ADMIN_EMAIL=admin@courier.local
SEED_ADMIN_PASSWORD=Admin@12345
SEED_BM_EMAIL=manager@courier.local
SEED_BM_PASSWORD=Manager@12345

# Cloudflare R2 (S3-compatible) — private direct uploads (Anjani + logos)
# Required for POST /api/v1/storage/generate-presigned-urls
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=courier-erp
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_PRESIGNED_URL_EXPIRY=600
R2_SIGNED_GET_EXPIRY=3600
R2_MAX_FILE_SIZE=524288000
R2_TEMP_CLEANUP_AGE_HOURS=24
# Custom CDN domain (hides bucket name in API URLs). Example: https://cdn.couriersync.in
# Leave empty to return R2 signed S3 URLs instead (those include the bucket name).
R2_PUBLIC_BASE_URL=
